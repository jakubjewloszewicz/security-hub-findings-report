<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>{{ title or 'AWS Security Hub Compliance Report' }}</title>
    <style>
        {{ css }}
    </style>
</head>
<body>
    <div class="cover-page">
        {{ cover_html|safe }}
